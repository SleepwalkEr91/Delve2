<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Delve</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="decompiled\**" />
    <None Remove="decompiled\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ExileCore">
      <HintPath Condition="Exists('$(exapiPackage)\ExileCore.dll')">$(exapiPackage)\ExileCore.dll</HintPath>
      <HintPath Condition="!Exists('$(exapiPackage)\ExileCore.dll')">..\..\..\ExileCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameOffsets">
      <HintPath Condition="Exists('$(exapiPackage)\GameOffsets.dll')">$(exapiPackage)\GameOffsets.dll</HintPath>
      <HintPath Condition="!Exists('$(exapiPackage)\GameOffsets.dll')">..\..\..\GameOffsets.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Hexa.NET.ImGui">
      <HintPath>$(exapiPackage)\Hexa.NET.ImGui.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Hexa.NET.ImGui" />
  </ItemGroup>
</Project>